QUALITYMAX_API_KEY=qm-your-api-key-here
QUALITYMAX_API_URL=https://app.qualitymax.io/api/mcp

# Read-only Bugsink access for the bugsink_* tools (delivery workspaces only).
# Use a read-scoped API token; it is read from the environment and never echoed
# back by the tools. Leave unset to disable the Bugsink tools.
QMAX_BUGSINK_URL=https://bugsink.example.com
QMAX_BUGSINK_TOKEN=your-read-only-bugsink-token
# Optional: cache TTL in seconds. Hard-capped at 600 (10 minutes).
QMAX_BUGSINK_CACHE_TTL_SECONDS=600
